table ip lport {}
delete table ip lport
table ip lport {
	chain prerouting {
		type nat hook prerouting priority -100; policy accept;
		tcp dport 8080 counter ct mark set ct mark or 0x01000000 dnat to 10.0.0.5:80
		tcp dport 5353 counter ct mark set ct mark or 0x01000000 dnat to 10.0.0.6:53
		udp dport 5353 counter ct mark set ct mark or 0x01000000 dnat to 10.0.0.6:53
	}
	chain output {
		type nat hook output priority -100; policy accept;
		fib daddr type local tcp dport 8080 dnat to 10.0.0.5:80
		fib daddr type local tcp dport 5353 dnat to 10.0.0.6:53
		fib daddr type local udp dport 5353 dnat to 10.0.0.6:53
	}
	chain postrouting {
		type nat hook postrouting priority 100; policy accept;
		ct status dnat ip daddr 10.0.0.5 tcp dport 80 masquerade
		ct status dnat ip daddr 10.0.0.6 tcp dport 53 masquerade
		ct status dnat ip daddr 10.0.0.6 udp dport 53 masquerade
	}
}
